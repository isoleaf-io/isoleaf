<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Sprint 9.5 — schemas ship as regular files copied to the build
       output instead of embedded resources. In dev the SchemaRegistry
       reads from <output>/Schemas; in Docker the same layout ships
       under /app/data/schemas (see Dockerfile) and can be swapped out
       via a volume mount without rebuilding the image. -->
  <ItemGroup>
    <Content Include="Schemas\**\*.xsd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
  </ItemGroup>

  <!-- Sprint 9.4 — Iso8583FlowService lives here (needs PixFlowStep and
       PaymentTestDataGenerator) but reuses IsoCore's IsoMessageBuilder /
       IsoParser / MtiParser to render the raw ISO 8583 wire strings. -->
  <ItemGroup>
    <ProjectReference Include="..\Iso8583Toolkit.IsoCore\Iso8583Toolkit.IsoCore.csproj" />
  </ItemGroup>

</Project>
