<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.1.1</Version>
  </PropertyGroup>

  <!-- Api is consumed by Agent as a project reference. Both are Web SDK
       projects, so both auto-include appsettings*.json and both files
       collide at publish time (NETSDK1152). Api's appsettings values are
       only used when this project runs standalone via `dotnet run` from
       source — never at publish. Skip them from the publish payload so
       Agent's own copies win without a duplicate error. -->
  <ItemGroup>
    <Content Update="appsettings*.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.13.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iso8583Toolkit.IsoCore\Iso8583Toolkit.IsoCore.csproj" />
    <ProjectReference Include="..\Iso8583Toolkit.Cards\Iso8583Toolkit.Cards.csproj" />
    <ProjectReference Include="..\Iso8583Toolkit.Cryptography\Iso8583Toolkit.Cryptography.csproj" />
    <ProjectReference Include="..\Iso8583Toolkit.Simulator\Iso8583Toolkit.Simulator.csproj" />
  </ItemGroup>

</Project>
