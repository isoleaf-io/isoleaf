<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Iso8583Toolkit.Backend-ca7010b7-e510-4570-b7e3-f7980819f2cb</UserSecretsId>
    <RootNamespace>Iso8583Toolkit.Backend</RootNamespace>
    <!-- Drives AssemblyVersion + InformationalVersion → /api/health's `version`
         field. Bump in lockstep with frontend/isohub/src/version.ts. -->
    <Version>3.0.0</Version>
    <!-- Surfaces controller XML <summary> and <remarks> comments into the
         OpenAPI document generated by Microsoft.AspNetCore.OpenApi (.NET 9).
         CS1591 silenced because we only annotate the publicly-documented
         actions, not every internal member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- OpenAPI + Scalar packages used to arrive transitively via the old
       Iso8583Toolkit.Api (Web SDK) project reference. Sprint 12.1 stripped
       the Api project down to a class library (renamed Application) with
       no ASP.NET packages, so the Agent host must now declare them itself.
       Versions pinned to the same ones the old Application csproj shipped. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.13.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Iso8583Toolkit.IsoCore\Iso8583Toolkit.IsoCore.csproj" />
    <ProjectReference Include="..\..\src\Iso8583Toolkit.Cards\Iso8583Toolkit.Cards.csproj" />
    <ProjectReference Include="..\..\src\Iso8583Toolkit.Cryptography\Iso8583Toolkit.Cryptography.csproj" />
    <ProjectReference Include="..\..\src\Iso8583Toolkit.Simulator\Iso8583Toolkit.Simulator.csproj" />
    <ProjectReference Include="..\..\src\Iso8583Toolkit.Application\Iso8583Toolkit.Application.csproj" />
    <ProjectReference Include="..\..\src\Iso8583Toolkit.Iso20022\Iso8583Toolkit.Iso20022.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iso8583Toolkit.Backend.Tests" />
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(SkipFrontend)' != 'true'">
    <Message Importance="high" Text="Building ISOLeaf frontend (Release)" />
    <Exec Command="npm install" WorkingDirectory="../../frontend/isohub" />
    <Exec Command="npm run build" WorkingDirectory="../../frontend/isohub" />
  </Target>

</Project>
