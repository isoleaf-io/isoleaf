<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Iso8583Toolkit.Agent</RootNamespace>
    <!-- Version tracked in lockstep with Backend + frontend. -->
    <Version>3.0.0</Version>
  </PropertyGroup>

  <!-- Simulator library holds the ports (IMessageFramer / ISessionStore /
       IMessageLog) plus SimulatorSession + TpduBuilder + AutoResponder etc.
       IsoCore drives the parser/builder. Cryptography powers ARQC/ARPC
       when EmvResponse mode is GenerateArpc. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Iso8583Toolkit.IsoCore\Iso8583Toolkit.IsoCore.csproj" />
    <ProjectReference Include="..\..\src\Iso8583Toolkit.Cryptography\Iso8583Toolkit.Cryptography.csproj" />
    <ProjectReference Include="..\..\src\Iso8583Toolkit.Simulator\Iso8583Toolkit.Simulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iso8583Toolkit.Agent.Tests" />
  </ItemGroup>

</Project>
